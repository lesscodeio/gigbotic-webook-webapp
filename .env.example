# Optional environment overrides for server.mjs & ecosystem.config.cjs
UI_HOST=127.0.0.1
UI_PORT=3450

# Optional initial console credentials (used only if data/auth.json does not exist yet;
# otherwise a random password is generated and printed once on first startup)
GIGBOTIC_CONSOLE_USER=gigbotic
GIGBOTIC_CONSOLE_PASSWORD=

# ---------------------------------------------------------------------------
# Per-Job Docker Sandbox & Host-Side Egress Proxy (runner-sandbox.mjs)
# ---------------------------------------------------------------------------

# Sandbox backend: auto | docker | native
# Default: auto (uses Docker whenever daemon + runner image are ready; falls back to native cli_sandbox)
# GIGBOTIC_SANDBOX_DRIVER=auto

# Set to 1 to fail-closed (abort) workspace_write jobs if Docker is unavailable
# Default: unset (0)
# GIGBOTIC_REQUIRE_DOCKER=1

# Docker image tag launched for each isolated job turn (build via `npm run docker:build`)
# Default: gigbotic-runner:latest
# GIGBOTIC_RUNNER_IMAGE=gigbotic-runner:latest

# Container RAM & swap cap (--memory & --memory-swap)
# Default: dynamic -> workspace_write: clamp(2g..8g, floor(hostMemGb * 0.55)); mcp_only/read_only: 2g
# GIGBOTIC_DOCKER_MEMORY=4g

# Container CPU quota (--cpus)
# Default: dynamic -> workspace_write: min(4, max(2, hostCpus)); mcp_only/read_only: 2
# GIGBOTIC_DOCKER_CPUS=2

# Container process/thread limit (--pids-limit)
# Default: workspace_write: 512; mcp_only/read_only: 128
# GIGBOTIC_DOCKER_PIDS_LIMIT=512

# Ephemeral /tmp RAM tmpfs size
# Default: workspace_write: 1g (rw,nosuid,nodev); mcp_only/read_only: 256m (rw,noexec,nosuid,nodev)
# GIGBOTIC_DOCKER_TMPFS_SIZE=1g

# Optional NVIDIA GPU pass-through forwarded to `docker run --gpus` (e.g. all or device=0)
# Default: unset (disabled)
# GIGBOTIC_DOCKER_GPUS=all

# Host-side egress allowlist proxy port (bound strictly to the br-gbsandbox Docker gateway IP)
# Default: 0 (ephemeral OS-assigned port)
# GIGBOTIC_EGRESS_PROXY_PORT=0
